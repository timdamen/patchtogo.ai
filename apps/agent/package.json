{
  "name": "agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "start": "node src/main.ts",
    "triage": "node --env-file-if-exists=.env src/triage-cli.ts",
    "retry": "node --env-file-if-exists=.env src/retry-cli.ts",
    "fix": "node --env-file-if-exists=.env --env-file-if-exists=.env.sandbox src/fix-cli.ts",
    "fork": "node --env-file-if-exists=.env --env-file-if-exists=.env.sandbox src/fork-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.65",
    "@hono/node-server": "^2.1.1",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "@patchtogo/fixer-runner": "workspace:*",
    "@vercel/sandbox": "^3.5.0",
    "ai": "^7.0.118",
    "hono": "^4.13.9",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
    "semver": "^7.8.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
